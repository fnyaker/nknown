# Démon local de NKnown, service utilisateur (jamais système, rien dans /etc).
#
# Installé par les paquets (/usr/lib/systemd/user, activé pour chaque utilisateur) ou par
# install.sh ; désactivable : systemctl --user disable --now nknownd.
#
# ExecStart suit l'installation par paquet ; install.sh le réécrit pour ~/.local ou /usr/local.

[Unit]
Description=NKnown : base de connaissances locale (indexation et recherche)
Documentation=https://github.com/fnyaker/nknown

[Service]
Type=exec
ExecStart=/usr/bin/nknownd
Restart=on-failure
RestartSec=5s

# Discret : le PC sert à autre chose. L'indexation passe après tout le reste.
Nice=15
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
MemoryHigh=2G

NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=default.target
